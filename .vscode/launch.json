{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug with cut at 20s + German audio",
            "cargo": {
                "args": [
                    "build",
                    "--bin=mkv_remuxer",
                    "--package=mkv_remuxer"
                ],
                "filter": {
                    "name": "mkv_remuxer",
                    "kind": "bin"
                }
            },
            "args": [
                "-i", "${workspaceFolder}/test_av1.webm",
                "--to", "15s",
                "--ss", "5s",
                "-m", "0:1",
                "-m", "0:3",
                "--seek-mode", "squeeze",
                "/tmp/output_debug.mkv"
            ],
            "cwd": "${workspaceFolder}"
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug stream_server",
            "cargo": {
                "args": [
                    "run",
                    "--example=stream_server",
                    "--package=mkv_remuxer"
                ],
                "filter": {
                    "name": "stream_server",
                    "kind": "example"
                }
            },
            "cwd": "${workspaceFolder}"
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "Run Cargo Tests",
            "cargo": {
                "args": [
                    "test",
                    "--package=mkv_remuxer"
                ],
                "filter": {
                    "kind": "test"
                }
            },
            "args": [],
            "cwd": "${workspaceFolder}"
        }
    ]
}