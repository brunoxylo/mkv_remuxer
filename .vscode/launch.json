    "version": "0.2.0",
    "configurations": [

        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug with cut at 20s + German audio",
            "cargo": {
                "args": [
                    "build",
                    "--bin=mkv_remuxer",
                    "--package=mkv_remuxer"
                ],
                "filter": {
                    "name": "mkv_remuxer",
                    "kind": "bin"
                }
            },
            "args": [
                "-i", "${workspaceFolder}/test.webm",
                "--to", "20s",
                "-m", "0:1",
                "-m", "0:3",
                "/tmp/output_debug.mkv"
            ],
            "cwd": "${workspaceFolder}"
        }
    ]
}